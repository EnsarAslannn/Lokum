{
  "manifest_version": 3,
  "name": "Lokum · Medya Araçları",
  "version": "1.0.1",
  "description": "Web görseli veya videosunda Ctrl + sol tık ile Lokum araçlarını aç.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lokum"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
